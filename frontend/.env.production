# Build-time settings for production (`vite build`). Not secret: these end up
# in the browser bundle. Secrets belong in Cloudflare (`wrangler secret put`).

# The API is served by the same Worker as the site, under /api.
VITE_API_BASE_URL=/api/v1

# The site's public address: canonical link, social cards, robots.txt and
# sitemap.xml. Keep it in step with "routes" in wrangler.jsonc.
VITE_SITE_URL=https://abdulwasiu.dev
