// Prisma schema for the backend package.
// Keep this file inside backend/ so pnpm can resolve @prisma/client locally.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  tag         String
  description String
  year        String
  category    String   @default("engineering")
  linkLabel   String   @map("link_label")
  linkUrl     String?  @map("link_url")
  imageUrl    String?  @map("image_url")
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([slug], map: "idx_projects_slug")
  @@index([category], map: "idx_projects_category")
  @@index([featured], map: "idx_projects_featured")
  @@index([order], map: "idx_projects_order")
  @@map("projects")
}

model PMProject {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  tag         String
  description String
  icon        String
  year        String
  linkLabel   String   @map("link_label")
  linkUrl     String?  @map("link_url")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([slug], map: "idx_pm_projects_slug")
  @@index([order], map: "idx_pm_projects_order")
  @@map("pm_projects")
}

model SkillCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  skills    Skill[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([order], map: "idx_skill_categories_order")
  @@map("skill_categories")
}

model Skill {
  id         String        @id @default(cuid())
  name       String
  percentage Int
  category   SkillCategory @relation(fields: [categoryId], references: [id])
  categoryId String        @map("category_id")
  order      Int           @default(0)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([categoryId], map: "idx_skills_category_id")
  @@index([order], map: "idx_skills_order")
  @@map("skills")
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String   @db.Citext
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([read], map: "idx_contacts_read")
  @@index([createdAt(sort: Desc)], map: "idx_contacts_created_at")
  @@index([email], map: "idx_contacts_email")
  @@map("contacts")
}
